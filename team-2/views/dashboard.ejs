        <h1>(show off wallet, or random marketplace items, or past transactions)</h1>
    </div>

    

    <nav class="navbar">
        <ul class="navbar__menu">
            <li class="navbar__item">
            <a href="#" class="navbar__link"><i data-feather="package"></i><span>Marketplace</span></a> 
