<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - UniTrade</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://unpkg.com/feather-icons"></script> <!-- Include Feather Icons library -->
</head>

<body>
    <div class="top-bar">
        <h1>Hello there, <%=user.name%>!</h1>
