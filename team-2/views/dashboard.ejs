            <li class="navbar__item">
            <a href="#" class="navbar__link"><i data-feather="credit-card"></i><span>Wallet</span></a>        
            </li>
            <li class="navbar__item">
            <a href="#" class="navbar__link"><i data-feather="archive"></i><span>Past Orders</span></a>        
            </li>
            <li class="navbar__item">
            <a href="#" class="navbar__link"><i data-feather="settings"></i><span>Settings</span></a>        
            </li>
            
        </ul>
    </nav>

    <img src="/css/basic-profile.png" class="navbar_profile">
    <script>
        feather.replace();  // Replace <i data-feather="icon-name"> with the actual SVG
    </script>
